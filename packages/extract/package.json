{
  "name": "@openparser/extract",
  "version": "1.0.11",
  "description": "Runtime-neutral grounded extraction algorithm: schema transforms, repair loop, citation resolution, and lineage production",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack:smoke": "bun scripts/pack-smoke.ts"
  },
  "dependencies": {
    "@openparser/lineage": "1.0.11",
    "@openparser/schema": "1.0.11",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "EigenPal",
    "email": "support@eigenpal.com",
    "url": "https://openparser.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigenpal/openparser.git",
    "directory": "packages/extract"
  },
  "homepage": "https://github.com/eigenpal/openparser#readme",
  "license": "Apache-2.0",
  "keywords": [
    "openparser",
    "extraction",
    "grounding",
    "lineage",
    "schema",
    "document-understanding"
  ],
  "bugs": {
    "url": "https://github.com/eigenpal/openparser/issues"
  }
}
