{
  "name": "@openparser/cli",
  "version": "0.1.0",
  "description": "Parse and extract documents from your terminal, CI jobs, or agent tools.",
  "keywords": [
    "openparser",
    "cli",
    "ocr",
    "document",
    "extraction",
    "parsing"
  ],
  "homepage": "https://github.com/eigenpal/openparser/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/eigenpal/openparser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigenpal/openparser.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "author": "OpenParser <hello@openparser.dev> (https://openparser.dev)",
  "type": "module",
  "bin": {
    "openparser": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node --format esm",
    "prepack": "bun run build",
    "generate": "bun run generate:cli-docs",
    "generate:check": "bun run generate:cli-docs:check",
    "generate:cli-docs": "bun scripts/generate-cli-docs.ts",
    "generate:cli-docs:check": "bun scripts/generate-cli-docs.ts --check",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack:smoke": "bun scripts/pack-smoke.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@openparser/sdk": "0.1.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
