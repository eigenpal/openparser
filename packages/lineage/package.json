{
  "name": "@openparser/lineage",
  "version": "1.0.2",
  "description": "Zod schemas, validation, and helpers for lineage@1 complete data-derivation DAGs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./openparser": {
      "types": "./src/profile/index.ts",
      "bun": "./src/profile/index.ts",
      "import": "./dist/profile/index.js",
      "default": "./dist/profile/index.js"
    },
    "./schema.json": "./lineage.schema.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "lineage.schema.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run schema:generate && bun scripts/build.ts",
    "prepack": "bun run build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack:smoke": "bun scripts/pack-smoke.ts",
    "schema:generate": "bun scripts/generate-json-schema.ts",
    "schema:check": "bun scripts/generate-json-schema.ts --check"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "luxon": "3.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/luxon": "3.7.4",
    "esbuild": "^0.25.12",
    "prettier": "3.8.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "EigenPal",
    "email": "support@eigenpal.com",
    "url": "https://openparser.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigenpal/openparser.git",
    "directory": "packages/lineage"
  },
  "homepage": "https://github.com/eigenpal/openparser#readme",
  "license": "Apache-2.0",
  "keywords": [
    "lineage",
    "provenance",
    "prov",
    "dag",
    "zod",
    "openparser"
  ],
  "bugs": {
    "url": "https://github.com/eigenpal/openparser/issues"
  }
}
