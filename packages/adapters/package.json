{
  "name": "@openparser/adapters",
  "version": "1.0.0",
  "description": "Convert provider OCR responses into openparser@1 documents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./paddle": {
      "types": "./src/paddle/index.ts",
      "bun": "./src/paddle/index.ts",
      "import": "./dist/paddle/index.js",
      "default": "./dist/paddle/index.js"
    },
    "./mistral": {
      "types": "./src/mistral/index.ts",
      "bun": "./src/mistral/index.ts",
      "import": "./dist/mistral/index.js",
      "default": "./dist/mistral/index.js"
    },
    "./azure-document-intelligence": {
      "types": "./src/azure-document-intelligence/index.ts",
      "bun": "./src/azure-document-intelligence/index.ts",
      "import": "./dist/azure-document-intelligence/index.js",
      "default": "./dist/azure-document-intelligence/index.js"
    },
    "./google-document-ai": {
      "types": "./src/google-document-ai/index.ts",
      "bun": "./src/google-document-ai/index.ts",
      "import": "./dist/google-document-ai/index.js",
      "default": "./dist/google-document-ai/index.js"
    },
    "./aws-textract": {
      "types": "./src/aws-textract/index.ts",
      "bun": "./src/aws-textract/index.ts",
      "import": "./dist/aws-textract/index.js",
      "default": "./dist/aws-textract/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-fixtures/**",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack:smoke": "bun scripts/pack-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "3.1093.0",
    "@openparser/schema": "1.0.0",
    "google-auth-library": "10.9.0",
    "pdf-lib": "1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "EigenPal",
    "email": "support@eigenpal.com",
    "url": "https://openparser.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigenpal/openparser.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/eigenpal/openparser#readme",
  "license": "Apache-2.0",
  "keywords": [
    "openparser",
    "ocr",
    "paddle",
    "hps",
    "adapter",
    "document-understanding"
  ],
  "bugs": {
    "url": "https://github.com/eigenpal/openparser/issues"
  }
}
