{
  "name": "@openparser/schema",
  "version": "1.0.1",
  "description": "Zod schemas and TypeScript types for openparser@1 documents and raw OCR envelopes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack:smoke": "bun scripts/pack-smoke.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "EigenPal",
    "email": "support@eigenpal.com",
    "url": "https://openparser.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigenpal/openparser.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/eigenpal/openparser#readme",
  "license": "Apache-2.0",
  "keywords": [
    "openparser",
    "ocr",
    "schema",
    "zod",
    "document-understanding"
  ],
  "bugs": {
    "url": "https://github.com/eigenpal/openparser/issues"
  }
}
